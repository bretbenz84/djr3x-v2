<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent for the DJ-R3X menu bar servo console (tools/rex_servo_menubar.py).

  This is a TEMPLATE. Do not load it directly — run scripts/install_supervisor.sh,
  which substitutes __PROJECT_ROOT__ with this repo's absolute path and installs
  the result to ~/Library/LaunchAgents/com.djr3x.servo.plist.

  It runs at login (RunAtLoad) and is kept alive (KeepAlive): a "Servo Control"
  menu bar item with live sliders for all 8 Maestro channels plus a Restart
  Pololu (go home) action. It opens MAESTRO_PORT directly while the robot is
  off and releases the port automatically whenever main.py is running (see the
  module docstring). A user LaunchAgent (not a system daemon) because the menu
  bar only exists inside a logged-in GUI session.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.djr3x.servo</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_ROOT__/venv/bin/python</string>
        <string>__PROJECT_ROOT__/tools/rex_servo_menubar.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Don't hammer relaunches if it exits immediately. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/logs/servo_menubar.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/logs/servo_menubar.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
