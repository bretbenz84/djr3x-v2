# ── Revert every behavior change from the 2026-08-05 evening session ─────────
# Paste into .env, restart, and have a normal conversation. If he stops ignoring
# you, the cause is in this session's work and we bisect by removing lines from
# the bottom up. If he still ignores you, the cause predates the session.
REX_MOOD_ENABLED=false
REACTION_AWARENESS_ENABLED=false
SMILE_REACTION_CANNED_LINES_ENABLED=true
GREETING_CADENCE_ENABLED=false
AEC_RELEASE_ON_QUEUE_DRAIN=false
LEAN_IMPULSE_PASS_REARM_FRACTION=1.0
LEAN_IMPULSE_MAX_UNANSWERED_VISIBLE_BONUS=0
ENGAGEMENT_PROBE_NO_ANSWER_SNOOZE_SECS=600
