# Host-specific hardware config — copy this file to .env and fill in real values.
# .env is excluded from git. Values differ per machine.
# Leave a value blank to gracefully disable that hardware feature.

# Safety phrase required after "wipe your memory" / full people-memory wipe.
# The spoken confirmation is: "confirm full wipe <this phrase>".
DJR3X_FULL_MEMORY_WIPE_ACCESS_CODE=Picard alpha 47 tango

# Microphone — prefer a device-name match so CoreAudio index changes do not
# break listening after reboot/replug. Matching is case-insensitive: exact name
# first, then a unique substring among input devices.
# List names with: python3 -c "import sounddevice as sd; print(sd.query_devices())"
# Examples: ReSpeaker, MacBook Air Microphone, MacBook Pro Microphone
AUDIO_DEVICE_NAME=MacBook Pro Microphone

# Optional fallback if AUDIO_DEVICE_NAME is blank or not found.
AUDIO_DEVICE_INDEX=

# ── Hardware AEC via ReSpeaker Lite (optional) ───────────────────────────────
# To let Rex be interrupted by a wake word WHILE he's speaking, his voice must be
# removed from the mic. Host-side software AEC was too weak in-room, so use the
# ReSpeaker Lite's onboard AEC instead. Requirements:
#   1) Flash the ReSpeaker Lite AEC firmware (ffva_ua_v2.0.6_output_proc0_ref0.bin)
#      via DFU — the stock firmware's AEC does not actually cancel. It puts the
#      echo-cancelled audio on channel 0 and the raw reference on channel 1.
#   2) Connect your amp/speaker to the ReSpeaker Lite's 3.5mm jack (or JST), so the
#      sound the mic hears is what the chip is using as its reference.
#   3) Route Rex's playback OUT through the ReSpeaker (so the chip gets the
#      reference): set the output device below.
#   4) Read only the AEC'd channel: AUDIO_AEC_INPUT_CHANNEL=0.
#   5) Allow the wake word to fire during his speech: WAKE_WORD_ALLOW_DURING_TTS=true
# Output device for playback (substring name, or use AUDIO_OUTPUT_DEVICE_INDEX).
AUDIO_OUTPUT_DEVICE_NAME=
AUDIO_OUTPUT_DEVICE_INDEX=
# Mic channel carrying the AEC-processed audio (0 with the firmware above; blank/-1
# = mix all channels = no hardware AEC).
AUDIO_AEC_INPUT_CHANNEL=
# Let the wake word fire while Rex is speaking (only safe with hardware AEC above;
# otherwise he self-triggers on his own lines).
WAKE_WORD_ALLOW_DURING_TTS=false

# Camera — choose one of these approaches:
# 1) Robot / USB camera: set CAMERA_INDEX to the OpenCV device index and leave CAMERA_DEVICE_NAME blank.
# 2) macOS dev / built-in camera: leave CAMERA_INDEX blank and set CAMERA_DEVICE_NAME to a device-name hint
#    like "FaceTime" or the full AVFoundation device name. The app will use ffmpeg for this path.
# List macOS camera names with: ffmpeg -f avfoundation -list_devices true -i ""
CAMERA_INDEX=0
CAMERA_DEVICE_NAME=

# Adaptive low-light frame gain (vision/camera.py). The camera has no auto-gain,
# so a dim room lands too dark for the face detector and Rex sees no one. This
# normalizes each frame's brightness toward a target: dim rooms get lifted, bright
# rooms get pulled down, normally-lit rooms pass through untouched. EMA-smoothed so
# it won't strobe. Room-specific, so tune it here. Set _ENABLED=false to disable.
# If a very dim room STILL reads no faces, raise _MAX toward 3-4 (brighter but
# noisier); if lifted frames look grainy or the detector false-fires, lower it.
CAMERA_AUTO_GAIN_ENABLED=true
CAMERA_AUTO_GAIN_TARGET_LUMA=110
CAMERA_AUTO_GAIN_MIN=0.6
CAMERA_AUTO_GAIN_MAX=2.5

# Live local pet/animal detection. Uses the downloaded MediaPipe Object Detector
# model and the shared camera frame buffer; no OpenAI credits are used.
LOCAL_ANIMAL_DETECTION_ENABLED=true
LOCAL_ANIMAL_DETECTION_PRELOAD_ON_STARTUP=true
LOCAL_ANIMAL_DETECTION_INTERVAL_SECS=2.0
LOCAL_ANIMAL_DETECTION_SCORE_THRESHOLD=0.45

# Optional OpenAI low-token scene-change monitor. Leave false if local pet
# detection is enough and you want to avoid periodic vision API calls.
SCENE_CHANGE_MONITOR_ENABLED=false

# Pololu Maestro Mini 18 — servo controller, 9600 baud.
# Typical macOS path: /dev/tty.usbmodem<serial>
MAESTRO_PORT=/dev/tty.usbmodem00000000

# Optional build-specific servo limits from the Pololu Maestro Control Center.
# Enter the Maestro app values in microseconds, not quarter-microseconds.
# Values outside 300-3000, non-numeric values, or half-filled min/max pairs stop startup.
# Leave both values blank for a channel only if the tracked defaults in config.py are safe for your build.
SERVO_NECK_MIN_US=
SERVO_NECK_MAX_US=
SERVO_HEADLIFT_MIN_US=
SERVO_HEADLIFT_MAX_US=
SERVO_HEADTILT_MIN_US=
SERVO_HEADTILT_MAX_US=
SERVO_VISOR_MIN_US=
SERVO_VISOR_MAX_US=
SERVO_ELBOW_MIN_US=
SERVO_ELBOW_MAX_US=
SERVO_HAND_MIN_US=
SERVO_HAND_MAX_US=
SERVO_POKERARM_MIN_US=
SERVO_POKERARM_MAX_US=
SERVO_HEROARM_MIN_US=
SERVO_HEROARM_MAX_US=

# Arduino Uno — head LEDs (82 NeoPixels), 115200 baud.
# Shares the same usbmodem prefix class as the Maestro; use the correct serial number.
ARDUINO_HEAD_PORT=/dev/tty.usbmodem00000001

# Arduino Nano — chest LEDs (98 WS2811 LEDs), 115200 baud, CH340 USB-serial adapter.
# Typical macOS path: /dev/tty.usbserial-<id>
ARDUINO_CHEST_PORT=/dev/tty.usbserial-00000000

# ESP32 motion controller — drive base, 115200 baud, USB-serial (CH340 or CP2102
# depending on board batch). setup_macos.sh auto-detects it by talking to its
# firmware over USB (the only board that answers the motion protocol with the
# "drive" cap). Unset = motion disabled. Wire contract: docs/motion_protocol.md;
# firmware: firmware/djr3x_motion.
# Typical macOS path: /dev/cu.usbserial-<id>
#
# Deliberately a PATH, not a serial number (unlike RADAR_ESP32_SERIAL below).
# Verified 2026-08-12 (pyserial + IOKit): the CH340 bridge ships NO iSerial
# descriptor — serial-number matching is physically impossible for it, and the
# chest Nano is an identical serial-less CH340 (same VID:PID 1a86:7523), so
# chip identity can't disambiguate either. What saves the path: macOS derives
# the cu.usbserial-<id> name from the USB LOCATION (usbserial-110 = locationID
# 0x1100000, bus 1 port 1), so it survives reboots and replug order and only
# changes if the cable moves to a different physical port — after which the
# setup script's protocol probe re-finds it.
MOTION_ESP32_PORT=/dev/cu.usbserial-0000

# ESP32-S3 radar ring — 3x HLK-LD2450 bearing-prior sensors, native USB CDC.
# Matched by USB SERIAL NUMBER (stable across reboots/replug — there are two
# ESP32s attached now and /dev/cu.usbmodem* numbering shuffles). Find it with:
#   venv/bin/python -c "import serial.tools.list_ports as lp; [print(p.device, p.serial_number) for p in lp.comports()]"
# RADAR_ESP32_PORT is a literal-path escape hatch (used when SERIAL is unset or
# not found). Both unset = radar disabled. Spec: docs/radar-bearing-prior-spec.md;
# firmware: firmware/djr3x_radar.
RADAR_ESP32_SERIAL=
#RADAR_ESP32_PORT=/dev/cu.usbmodem00000000
