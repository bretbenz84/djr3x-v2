marimo/_static/
marimo/_lsp/
__marimo__/

# DJ-R3X project-specific

# API credentials
apikeys.py

# User-facing config overrides (copied from user_config.example.py by setup)
user_config.py

# AI models — most are downloaded by setup_assets.py and too large for git.
# Keep wake-word ONNX assets tracked so fresh installs can interrupt/listen.
assets/models/*
!assets/models/wake_word/
assets/models/wake_word/*
!assets/models/wake_word/*.onnx
!assets/models/wake_word/_openwakeword_resources/
assets/models/wake_word/_openwakeword_resources/*
!assets/models/wake_word/_openwakeword_resources/*.onnx
# Keep the MediaPipe pose model tracked so it reaches the robot on git push
# (deploy = commit+push to main). It's ~5.5MB and otherwise wouldn't sync, leaving
# wave-back / gesture detection silently disabled on-device.
!assets/models/pose/
assets/models/pose/*
!assets/models/pose/*.task

# TTS audio cache — rebuilt automatically from ElevenLabs
assets/audio/tts_cache/

# Voice reference clips for the local Qwen3-TTS clone + impersonation feature.
# Person clips (people/) are personal/biometric-ish data and famous-person clips
# (famous/) are user-supplied — neither belongs in git. Rex's OWN reference
# (rex/) IS tracked: --local-tts is dead without it on a fresh checkout (the
# dev-mac silently fell back to ElevenLabs when it was missing, 2026-07-19), and
# the repo already ships Star Tours audio (assets/audio/startup/*.mp3), so the
# licensing posture is unchanged. Dirs are recreated by setup_assets.py.
assets/voices/*
!assets/voices/rex/

# Local music files — user-supplied, not part of the project
assets/music/

# Gamepad soundboard clips — user-supplied MP3s (assets/audio/clips/*.mp3), local audio
assets/audio/clips/

# Local runtime memory — person DB (people.db), Rex's episodic diary (rex.db),
# POV state, their -shm/-wal/.bak siblings, and any manual copies/backups.
# All of it is local runtime data; never commit. setup_assets.py recreates the
# folder at runtime, so ignoring the whole thing is safe.
assets/memory/

# Visual place recognition store (perception/place_recognition.py, PLACE_DB_PATH).
# The live places.db binary + its -shm/-wal siblings are local runtime data; the
# schema is (re)created on first run. Never commit the binary.
data/places.db
data/places.db-shm
data/places.db-wal


# Startup boot-line rotation state — local runtime bookkeeping
assets/state/

# Runtime logs
logs/

# Single-instance lock (if DJR3X_LOCK_PATH points inside the repo)
*.lock
djr3x-main.lock

.VSCodeCounter/

# 20 Questions — raw allenai/twentyquestions dataset (large; distilled into the tracked
# assets/20questions/r3x_kb.json by assets/20questions/build_kb.py).
assets/20questions/twentyquestions-*.jsonl
kokoro_samples/
piper_samples/
piper_voices/
tts_samples/

# Local-LLM evaluation POC (venv, downloaded models, generated results — evaluation only)
tests/local_llm_poc/
